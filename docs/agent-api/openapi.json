  "openapi": "3.1.0",
  "info": {
    "title": "Gomez Garage Studio — Service read API",
    "version": "1.1.0",
    "description": "Local pilot contract, not deployed. Site orders only; no Etsy, write, customer messaging or payment operations. Orders include a deterministic pseudonymous customer_ref for repeat-purchase analysis; no raw contact fields are returned. Decimal amounts represent order value in EUR, not receipts."
  },
  "servers": [
    {
      "url": "/studio/api/agent/v1",
      "description": "Relative to the separately verified HTTPS shop origin."
    }
  ],
  "security": [
    {
      "serviceBearer": []
    }
  ],
