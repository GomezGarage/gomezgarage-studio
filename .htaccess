# GOMEZ GARAGE STUDIO — root .htaccess
# ARCHITECTURE.md section 9: config.php and internal folders must never be
# reachable directly, and directory listings must be off everywhere.

Options -Indexes
ServerSignature Off

# Never serve the config file or composer metadata directly.
<FilesMatch "^(config\.php|config\.example\.php|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

# Block direct access to shared PHP includes, the raw SQL schema,
# one-off CLI admin scripts, and generated PDF invoices — none of these
# are ever requested over HTTP directly (invoices are streamed through
# api/download-invoice.php instead).
RewriteEngine On
RewriteRule ^(?:\.git(?:/|$)|(?:includes|database|scripts|invoices|tests|docs)/) - [F,L]

# Keep the public .html URLs while rendering live catalog content and metadata.
RewriteRule ^product\.html$ product.php [L]
RewriteRule ^products\.html$ products.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
